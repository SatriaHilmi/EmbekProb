---
// import Layout from "../layouts/Layout.astro";
import { Instagram } from "lucide-react";
import { Facebook } from "lucide-react";
---

<div slot="footer" id="contact">
    <div class="bg-green-700 text-white py-5">
        <div
            class="w-full mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 px-5 text-center md:text-left"
        >
            <!-- Logo & Sosial Media -->
            <div class="flex flex-col items-center md:items-start gap-4">
                <span class="font-bold text-xl">
                    Logo Embek Probolinggo Farm
                </span>
                <div class="flex items-center gap-2">
                    <a href=""><Instagram /></a>
                    <a href=""><Facebook /></a>
                </div>
            </div>

            <!-- Alamat / Copyright -->
            <div class="flex justify-center items-center text-sm">
                <p>
                    &copy; {new Date().getFullYear()} Embek Probolinggo Farm — All
                    Rights Reserved
                </p>
            </div>

            <!-- Kontak -->
            <div
                class="flex flex-col items-center md:self-end text-md border border-white p-4 rounded-lg"
            >
                <div class="items-center justify-center md:justify-end">
                    <p
                        class="font-semibold font-bebas text-center text-xl md:text-center"
                    >
                        Contact
                    </p>
                    <p class="flex items-center gap-2 text-lg">
                        <span class="font-semibold font-bebas text-xl"
                            >Email :</span
                        >embekfarm@gmail.com
                    </p>
                    <p class="flex items-center gap-2 text-lg">
                        <span class="font-semibold font-bebas text-xl"
                            >Phone :</span
                        >+62 812-3456-7890
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
